# lifestats configuration. Copy to .env (never commit it) and fill in.
# In the cloud set the same variables in your hosting provider (Vercel → Project → Settings → Environment Variables).
# Generate secrets with:  openssl rand -hex 24      (BACKUP_KEY: openssl rand -hex 32)

# ---- required --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=          # from @BotFather
APP_URL=                     # public URL of the Mini App, e.g. https://<your-app>.vercel.app/app
APP_TZ=UTC                   # your time zone, e.g. Europe/Berlin, Asia/Tashkent
CRON_SECRET=                 # protects /tick and /cron
INGEST_TOKEN=                # key for iPhone Shortcuts that send data (health, calendar, reminders, screen time)

# ---- database ---------------------------------------------------------------
# Empty = local SQLite file in DATA_DIR (self-hosting). For serverless hosting use Turso (free tier):
TURSO_DATABASE_URL=          # libsql://<db>-<org>.turso.io
TURSO_AUTH_TOKEN=
DATA_DIR=data

# ---- AI assistant (optional, any OpenAI-compatible API) ---------------------
# Groq has a free tier and is the default. Others: https://api.openai.com/v1, https://openrouter.ai/api/v1,
# a local Ollama http://localhost:11434/v1 (no key needed) …
LLM_BASE_URL=                # default: https://api.groq.com/openai/v1
LLM_API_KEY=                 # (GROQ_API_KEY also works)
ASSISTANT_MODELS=            # fallback order, comma-separated; default: openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
ASSISTANT_EFFORT=medium      # reasoning effort for gpt-oss models: low | medium | high
WEB_SEARCH=1                 # web search (Groq gpt-oss only); 0 to turn off
# Voice messages (speech-to-text) use the same provider unless set separately:
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
ASK_TOKEN=                   # separate key for the Siri Shortcut (it can drive the assistant)

# ---- optional ---------------------------------------------------------------
BACKUP_KEY=                  # 64 hex chars; enables the weekly encrypted backup sent to your chat
LASTFM_API_KEY=              # music statistics from Last.fm
LASTFM_USER=
CRONJOB_API_KEY=             # only for scripts/cronjob-setup.ts (creates the every-minute job on cron-job.org)
PORT=3000                    # self-hosting only
